# longrun config. Plain shell assignments; read by bin/longrun and the check scripts.
LONGRUN_PRESET=code
# Loop tag: ticks print AGENT_LOOP_TICK_<LONGRUN_NAME>. Seconds between ticks.
LONGRUN_NAME=run
LONGRUN_TICK_SEC=600
# `longrun watch` alerts when no state file changed for this many minutes.
LONGRUN_STALE_MIN=30
# Unit worktrees go to $LONGRUN_WORKTREE_DIR/<repo>-<unit> (relative to the repo root).
LONGRUN_WORKTREE_DIR=..
# Lead chat id for `longrun report` (find it with `longrun report --list-chats`).
LONGRUN_LEAD_CHAT=
# The lead restarts from longrun/handoff.md after about this many turns.
LONGRUN_RESTART_TURNS=100
# Where Playwright is installed (node_modules dir). Workers read this instead of searching.
LONGRUN_PLAYWRIGHT=
